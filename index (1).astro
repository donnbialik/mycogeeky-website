---
import Base from '../layouts/Base.astro';
import QuestionPicker from '../components/QuestionPicker';
---
<Base title="Stay Curious. Stay Cultivating."><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">A HOME FOR THE CURIOUS</p><h1>There's always <em>more</em> to discover.</h1><p class="lead">A place to wonder about fungi, explore how science works, and connect with people who ask interesting questions.</p><div class="actions"><a class="button primary" href="/curious/">Follow your curiosity →</a><a class="button outline" href="/investigate/">Investigate fungi</a></div></div><div class="hero-art" aria-label="Abstract natural history illustration"><span class="art-ring">✳</span><span class="art-caption">LOOK CLOSER. ASK WHY.</span></div></div></section><section class="section"><div class="container"><p class="eyebrow">CHOOSE YOUR OWN DEPTH</p><h2>No prerequisites. No finish line.</h2><div class="feature-grid"><a class="feature" href="/explore/"><span>01 / EXPLORE</span><h3>Find your wonder.</h3><p>Field stories, photographs, people and discoveries.</p></a><a class="feature" href="/curious/"><span>02 / GET CURIOUS</span><h3>Follow a question.</h3><p>Playful mysteries that invite closer observation.</p></a><a class="feature" href="/investigate/"><span>03 / INVESTIGATE</span><h3>Examine the evidence.</h3><p>Guided research and tools for doing real work.</p></a><a class="feature" href="/connect/"><span>ALWAYS / CONNECT</span><h3>Find your people.</h3><p>Relationships, shared projects and collaboration.</p></a></div></div></section><section class="section soft"><div class="container split"><div><p class="eyebrow">THE QUESTION IS THE BEGINNING</p><h2>You don't need permission to be curious.</h2><p>Take science seriously without taking yourself too seriously. Respect expertise, examine evidence, and make room for people who want to contribute.</p></div><QuestionPicker client:load /></div></section></Base>
