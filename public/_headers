# Cloudflare Pages response headers.
# The Explorer is a restricted reviewer application: never index it and never cache it.
/explorer/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# ITS Bin Comparator: a self-contained page; allow normal caching but never framing.
/investigate/its-bin-comparator/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# iNat Seasonality Explorer: a self-contained page that calls the public iNaturalist API from the browser.
/investigate/seasonality-explorer/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Provisional Finder: a self-contained page that calls the public iNaturalist API from the browser.
/investigate/provisional-finder/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Ecology Profile: a self-contained page; calls iNaturalist, Open-Meteo, SoilGrids and USGS from the browser, and /api/env relays.
/investigate/ecology-profile/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Habitat Profiler: a self-contained page; calls iNaturalist and Open-Meteo from the browser, and /api/env relays.
/investigate/habitat-profiler/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
