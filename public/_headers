# Cloudflare Pages response headers.
# The Explorer is a restricted reviewer application: never index it and never cache it.
/explorer/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# ITS Bin Comparator: a self-contained page; allow normal caching but never framing.
/investigate/its-bin-comparator/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
