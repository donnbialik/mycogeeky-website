{kind==='specimen' && <g><rect x="95" y="18" width="130" height="137" rx="4"/><path d="M110 34 H168 M110 44 H149 M110 133 H211 M110 143 H178" opacity=".5"/><path d="M160 116 V83 M133 83 Q131 51 160 51 Q189 51 187 83 Z M133 83 Q160 93 187 83"/><path d="M112 102 H140 M180 102 H208" opacity=".3"/></g>}
