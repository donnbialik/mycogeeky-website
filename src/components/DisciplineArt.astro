<svg viewBox="0 0 320 170" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
<circle cx="268" cy="37" r="63" opacity=".09" fill="currentColor" stroke="none"/><circle cx="42" cy="147" r="70" opacity=".07" fill="currentColor" stroke="none"/>
{kind==='mushroom' && <g><path d="M44 138 V98 M27 98 Q44 54 61 98 Z M44 98 Q44 107 61 98"/><path d="M116 138 V96 M91 96 Q116 43 141 96 Z M91 96 Q116 108 141 96"/><path d="M205 138 V98 M186 98 Q205 56 224 98 Z M186 98 Q205 108 224 98"/><path d="M270 138 V102 M252 102 Q270 66 288 102 Z M252 102 Q270 112 288 102"/><rect x="15" y="28" width="143" height="125" rx="17" stroke="var(--discipline-accent)" stroke-dasharray="6 7"/><rect x="177" y="28" width="126" height="125" rx="17" stroke="var(--discipline-accent)" stroke-dasharray="6 7"/><path d="M164 20 V160" stroke-dasharray="2 7" opacity=".45"/></g>}
