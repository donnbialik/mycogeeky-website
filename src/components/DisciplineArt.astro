{kind==='tree' && <g><path d="M160 149 V120 L102 83 L67 42 M102 83 L137 42 M160 120 L220 83 L185 42 M220 83 L255 42"/>{[67,137,185,255].map(x=><circle cx={x} cy="39" r="12"/>)}<circle cx="102" cy="83" r="9" fill="var(--discipline-accent)"/><path d="M102 83 L67 42 M102 83 L137 42" stroke="var(--discipline-accent)" stroke-width="5"/><path d="M49 20 H153" stroke-dasharray="5 5" opacity=".4"/></g>}
{kind==='book' && <g><path d="M159 48 Q120 30 70 42 V140 Q123 128 159 150 Q197 128 249 140 V42 Q199 30 159 48 Z M159 48 V150"/><path d="M89 66 H139 M89 82 H139 M89 98 H127 M179 66 H230 M179 82 H230 M179 98 H214"/><path d="M127 115 L144 128 L191 99" stroke="var(--discipline-accent)" stroke-width="6"/></g>}
