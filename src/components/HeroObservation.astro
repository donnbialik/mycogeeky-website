---
import { featuredObservation as feature } from '../data/featuredObservation';
const observationUrl = `https://www.inaturalist.org/observations/${feature.id}`;
let observation: any = null;
try {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 4500);
  try {
    const response = await fetch(`https://api.inaturalist.org/v1/observations/${feature.id}`, {
      headers: { Accept: 'application/json' }, signal: controller.signal,
    });
    if (response.ok) {
      const data = await response.json();
      observation = data.results?.find((item: any) => item.id === feature.id) ?? null;
    }
  } finally { clearTimeout(timeout); }
} catch {
  // The observation remains accessible even when the upstream service is unavailable.
}
const taxonName = observation?.taxon?.name || 'Identification awaiting verification';
const commonName = observation?.taxon?.preferred_common_name || '';
const observedDate = observation?.observed_on ? new Date(observation.observed_on + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '';
const place = observation?.place_guess || '';
const observer = observation?.user?.login || '';
const isProvisional = /\bsp\.|['‘’"]/.test(taxonName);
---
<div class="mv-observation-widget">
  <button type="button" class="mv-observation-trigger" data-open-observation aria-haspopup="dialog" aria-label="View the featured mushroom specimen and observation details">
    <span class="mv-observation-dot" aria-hidden="true">◎</span>
    <span class="mv-observation-label"><small>FEATURED FIELD OBSERVATION</small><strong>What mushrooms are these?</strong></span><span class="mv-observation-go" aria-hidden="true">→</span>
  </button>
  <dialog class="mv-observation-dialog" aria-labelledby="mv-observation-heading" data-observation-dialog>
    <div class="mv-observation-dialog-head">
      <div><p class="mv-kicker">MYCOVIEW FIELD NOTES · INATURALIST</p><h2 id="mv-observation-heading">Behind the photograph</h2></div>
      <button type="button" class="mv-observation-close" data-close-observation aria-label="Close observation details">×</button>
    </div>
    <div class="mv-observation-dialog-body">
      <p class="mv-observation-record">OBSERVATION #{feature.id}</p>
      <p class="mv-observation-id-label">{isProvisional ? 'PROVISIONAL IDENTIFICATION' : 'IDENTIFICATION'}</p>
      <h3>{taxonName}</h3>
      {commonName && <p class="mv-observation-common">{commonName}</p>}
      <dl class="mv-observation-facts">
        {observedDate && <><dt>Observed</dt><dd>{observedDate}</dd></>}
        {place && <><dt>Location</dt><dd>{place}</dd></>}
        {observer && <><dt>Observer</dt><dd>@{observer}</dd></>}
      </dl>
      {isProvisional && <p class="mv-observation-notice">This is an informal identification, not necessarily a formally described species.</p>}
      <p><strong>Field note:</strong> {feature.fieldNote}</p>
      <p class="mv-observation-question">{feature.question}</p>
      {!observation && <p class="mv-observation-notice">Live observation details were unavailable when this page was built. Use the original observation to see the current identification and metadata.</p>}
      <a class="mv-primary" href={observationUrl} target="_blank" rel="noopener noreferrer">View original iNaturalist record ↗</a>
    </div>
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.mv-observation-widget').forEach(widget => {
    const dialog = widget.querySelector<HTMLDialogElement>('[data-observation-dialog]');
    const trigger = widget.querySelector<HTMLButtonElement>('[data-open-observation]');
    const close = widget.querySelector<HTMLButtonElement>('[data-close-observation]');
    if (!dialog || !trigger || !close) return;
    trigger.addEventListener('click', () => dialog.showModal());
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style is:global>
/* Make the photograph's field-note invitation unmistakably interactive. */
.mv-observation-trigger{cursor:pointer}
.mv-observation-label{display:flex;flex-direction:column;align-items:flex-start;flex:1;min-width:0}
.mv-observation-go{display:grid;place-items:center;flex:none;width:36px;height:36px;border:1.5px solid #d9ec86;border-radius:50%;color:#e8f3b1;font-size:1.35rem;line-height:1;transition:background .2s,color .2s,transform .2s}
.mv-observation-trigger:hover .mv-observation-go,.mv-observation-trigger:focus-visible .mv-observation-go{background:#d9ec86;color:#103a2e;transform:translateX(2px)}
.mv-observation-trigger:focus-visible{outline:3px solid #e8c679;outline-offset:-4px}
@media(max-width:760px){
 .mv-home .mv-observation-trigger{min-height:70px!important;padding:12px 20px!important;gap:13px!important;background:#205640!important}
 .mv-home .mv-observation-trigger small{font-size:.58rem!important;letter-spacing:.11em!important}
 .mv-home .mv-observation-trigger strong{font-size:1rem!important;line-height:1.3!important;color:#fff!important}
 .mv-home .mv-observation-go{width:38px;height:38px}
}
/* A gentle, intermittent beacon on the arrow, not a flashing banner. */
.mv-observation-go{position:relative;isolation:isolate;animation:mv-observation-breathe 3.4s ease-in-out infinite}
.mv-observation-go:after{content:'';position:absolute;inset:-4px;border-radius:50%;border:1px solid #d9ec86;opacity:0;pointer-events:none;animation:mv-observation-ring 3.4s ease-out infinite}
@keyframes mv-observation-breathe{0%,18%,75%,100%{box-shadow:0 0 8px 1px #d9ec8638,0 0 18px 2px #d9ec861b;background:#d9ec8610}38%,53%{box-shadow:0 0 12px 4px #d9ec86a6,0 0 28px 9px #d9ec865c,0 0 42px 13px #d9ec8626;background:#d9ec8633}}
@keyframes mv-observation-ring{0%,17%,70%,100%{opacity:0;transform:scale(1)}35%{opacity:.65;transform:scale(1.12)}62%{opacity:0;transform:scale(1.4)}}
@media(prefers-reduced-motion:reduce){.mv-observation-go{transition:none;animation:none}.mv-observation-go:after{animation:none;display:none}}
</style>
