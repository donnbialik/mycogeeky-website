---
/**
 * <NewsletterForm tone="dark" id="footer-news" />
 * Email sign-up for the MycoView newsletter (Buttondown). Subscribers are tagged
 * with newsletterTag from src/data/site.ts. Renders nothing if no Buttondown username is set.
 * tone: 'dark' on dark-green backgrounds (footer), 'light' on cream ones.
 */
import { buttondownUsername, newsletterTag } from '../data/site';
interface Props { id: string; tone?: 'dark' | 'light' }
const { id, tone = 'light' } = Astro.props;
const action = `https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`;
---
{buttondownUsername && (
  <form class:list={['mv-news', `mv-news-${tone}`]} method="post" action={action} aria-label="MycoView newsletter sign-up">
    <label for={`${id}-email`}>Get new tools, stories and episodes by email</label>
    <div class="mv-news-row">
      <input id={`${id}-email`} type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
      <input type="hidden" name="tag" value={newsletterTag} />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
    </div>
    <p class="mv-news-note">Occasional emails. Unsubscribe anytime. <a href="/privacy/">Privacy</a></p>
  </form>
)}
