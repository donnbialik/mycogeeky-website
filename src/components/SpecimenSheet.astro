---
/* Homepage specimen sheet, after classic herbarium specimen photos (MycoView Design System: SpecimenSheet).
   Everything on it comes from the featured iNaturalist observation, fetched at build time.
   Honesty rules: no drawn scale bar or colour card (a scale only counts when it is in the photo itself);
   cards filled in from data are typed, never fake handwriting; a missing value is left out, never guessed. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface SheetData {
  id: number;
  name: string;
  provisional: boolean;
  observed: string;         // e.g. "27 May 2026"
  locality: string;
  habitat?: string;
  collector: string;
  its?: { length: number; tech?: string; reads?: string; plate?: string };
}
interface Props { data: SheetData; photo: ImageMetadata; photoAlt: string; }
const { data, photo, photoAlt } = Astro.props;

// Code 39 barcode of the observation number (start/stop '*'), drawn at build time.
const C39: Record<string, string> = { '0':'nnnwwnwnn','1':'wnnwnnnnw','2':'nnwwnnnnw','3':'wnwwnnnnn','4':'nnnwwnnnw','5':'wnnwwnnnn','6':'nnwwwnnnn','7':'nnnwnnwnw','8':'wnnwnnwnn','9':'nnwwnnwnn','*':'nwnnwnwnn' };
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const ch of `*${data.id}*`) {
  const pattern = C39[ch];
  if (!pattern) continue;
  [...pattern].forEach((e, i) => { const w = e === 'w' ? 3.5 : 1.4; if (i % 2 === 0) bars.push({ x, w }); x += w; });
  x += 1.4;
}
const barcodeWidth = Math.round(x * 10) / 10;

// Split "Genus sp. 'epithet'" so genus can be underlined/italic the way a typed label does it.
const m = data.name.match(/^(\S+)\s+(.*)$/);
const genus = m ? m[1] : data.name;
const rest = m ? m[2] : '';
const inatUrl = `https://www.inaturalist.org/observations/${data.id}`;
const restParts = rest.split(/('[^']+')/).filter(Boolean).map(part => ({ text: part, quoted: part.startsWith("'") }));
const determinedBy = data.its ? (data.provisional ? 'ITS barcode (provisional)' : 'ITS barcode') : 'iNaturalist community';
const itsLine = data.its ? [data.its.tech, data.its.reads ? `${data.its.reads} reads in consensus` : ''].filter(Boolean).join(', ') : '';
---
<figure class="sheet" aria-label={`Specimen sheet for ${data.name}`}>
  <div class="sheet-top">
    <span class="sheet-code">MYCOVIEW</span>
    <a class="sheet-sticker" href={inatUrl} target="_blank" rel="noopener noreferrer" aria-label={`iNaturalist observation ${data.id}, opens in a new tab`}>
      <span class="sheet-sticker-head">MycoView · iNaturalist</span>
      <svg viewBox={`0 0 ${barcodeWidth} 34`} preserveAspectRatio="none" aria-hidden="true">{bars.map(b => <rect x={b.x} y="0" width={b.w} height="34" />)}</svg>
      <span class="sheet-sticker-num">{data.id}</span>
    </a>
  </div>

  <div class="sheet-row">
    <div class="sheet-print">
      <Image src={photo} alt={photoAlt} widths={[480, 760, 1100]} sizes="(max-width: 760px) 92vw, 34vw" loading="eager" />
    </div>
    {data.its && (
      <div class="sheet-card sheet-typed">
        <p class="sheet-card-head">MYCOVIEW FIELD STATION · DNA BARCODE</p>
        <hr />
        <p><u>{genus.toUpperCase()}</u> {restParts.map(p => p.quoted ? <u>{p.text}</u> : <span>{p.text}</span>)}</p>
        <p class="ind">ITS, {data.its.length} bp.</p>
        {itsLine && <p class="ind">{itsLine}.</p>}
        {data.its.plate && <p class="ind">Mycota Lab plate {data.its.plate}.</p>}
      </div>
    )}
  </div>

  <div class="sheet-row">
    <div class="sheet-card sheet-form">
      <p class="sheet-card-head">MYCOVIEW FIELD STATION · NORTHEAST OHIO</p>
      <hr />
      <p><u><i>{genus}</i></u> {rest}</p>
      {data.habitat && <p class="ind">{data.habitat}</p>}
      <p class="ind">{data.locality}</p>
      <p class="ind">{data.observed}.</p>
      <p class="sheet-line"><span>COLLECTED BY</span>{data.collector}</p>
      <p class="sheet-line"><span>DETERMINED BY</span>{determinedBy}</p>
    </div>
    {data.provisional && (
      <div class="sheet-provisional">
        <p>PROVISIONAL</p>
        <p>not yet formally described</p>
      </div>
    )}
  </div>
</figure>

<style>
.sheet { margin: 0; background: var(--ds-paper-sheet); color: var(--ds-paper-ink); padding: 22px; box-shadow: var(--ds-shadow-sheet); display: flex; flex-direction: column; gap: 18px; }
.sheet-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
.sheet-code { border: 1.5px solid var(--ds-scale-black); padding: 6px 12px; font-family: var(--ds-font-display); font-size: 22px; font-weight: 500; background: var(--ds-paper-card); }
.sheet-sticker { display: block; width: 220px; background: var(--ds-paper-card); box-shadow: var(--ds-shadow-card); padding: 8px 12px 6px; text-align: center; text-decoration: none; color: inherit; }
.sheet-sticker svg { display: block; width: 100%; height: 34px; fill: var(--ds-scale-black); }
.sheet-sticker-head { display: block; font-size: 12px; margin-bottom: 4px; }
.sheet-sticker-num { display: block; font-size: 13px; letter-spacing: .08em; margin-top: 3px; }
.sheet-row { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
.sheet-print { flex: 1 1 340px; min-width: 0; background: var(--ds-paper-card); padding: 8px; box-shadow: var(--ds-shadow-card); }
.sheet-print img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
.sheet-card { flex: 1 1 260px; min-width: 0; background: var(--ds-paper-card); box-shadow: var(--ds-shadow-card); padding: 16px 20px 14px; font-family: var(--ds-font-mono); font-size: 15px; line-height: 1.45; }
.sheet-form { flex: 1 1 340px; background: var(--ds-paper-card-warm); }
.sheet-card p { margin: 0; }
.sheet-card .ind { padding-left: 2ch; }
.sheet-card-head { text-align: center; font-family: var(--ds-font-display) !important; font-stretch: 68%; font-weight: 800; font-size: 16px; letter-spacing: .05em; }
.sheet-card hr { width: 110px; margin: 8px auto 12px; border: 0; border-top: 2px solid var(--ds-paper-ink); }
.sheet-line { display: flex; gap: 12px; align-items: baseline; }
.sheet-line span { flex: none; width: 112px; font-family: var(--ds-font-display); font-weight: 700; font-size: 12px; letter-spacing: .06em; }
.sheet-provisional { flex: 1 1 200px; border: 10px solid var(--ds-label-red); background: var(--ds-paper-card); box-shadow: var(--ds-shadow-card); padding: 12px 16px; font-family: var(--ds-font-mono); }
.sheet-provisional p { margin: 0; font-size: 15px; }
.sheet-provisional p:first-child { font-weight: 700; font-size: 20px; letter-spacing: .04em; }
@media (max-width: 480px) { .sheet { padding: 14px; gap: 14px; } .sheet-sticker { width: 180px; } }
</style>
