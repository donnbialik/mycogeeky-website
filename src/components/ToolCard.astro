---
import type {ResearchTool} from '../data/tools';
const {tool}=Astro.props as {tool:ResearchTool};
const available=Boolean(tool.href);
const maturity:Record<ResearchTool['lifecycle'],string>={
 experimental:'Experimental',beta:'Beta',stable:'Stable',archived:'Archived'
};
const validation:Record<ResearchTool['validation'],string>={
 'not-evaluated':'Not independently evaluated',
 'under-review':'Scientific review in progress',
 'validated-for-scope':'Validated for stated scope'
};
---
<article class="tool-card mv-tool-card" data-availability={available?'available':'planned'}>
 <div class="eyebrow">{tool.category}</div>
 <h3>{tool.name}</h3>
 <p>{tool.description}</p>
 <div class="mv-tool-status-row" aria-label="Tool status">
  <span class="mv-tool-state" data-state={available?'available':'planned'}>{available?'✓ Available to explore':'◷ Not yet available'}</span>
  <span class="mv-tool-state is-neutral">{maturity[tool.lifecycle]}</span>
 </div>
 <p class="mv-tool-science"><strong>Scientific status:</strong> {validation[tool.validation]}. This is separate from whether the software can be opened.</p>
 {tool.limitations.length>0&&<details class="mv-tool-limits"><summary>What this tool cannot establish</summary><ul>{tool.limitations.map(limit=><li>{limit}</li>)}</ul></details>}
 {available?<a class="text-link mv-tool-open" href={tool.href}>Explore {tool.name} →</a>:<p class="mv-tool-unavailable">This tool is on the development roadmap. No working application is linked yet.</p>}
</article>