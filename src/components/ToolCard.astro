---
import type {ResearchTool} from '../data/tools';
import {stepsFor} from '../data/tools';
const {tool}=Astro.props as {tool:ResearchTool};
const steps=stepsFor(tool.id);
const available=Boolean(tool.href);
const invitation=available&&tool.access==='invitation';
const state=invitation?'invitation':available?'available':'planned';
const stateLabel={available:'✓ Available to explore',invitation:'◐ Preview / by invitation',planned:'◷ Not yet available'}[state];
const maturity:Record<ResearchTool['lifecycle'],string>={
 experimental:'Experimental',beta:'Beta',stable:'Stable',archived:'Archived'
};
const validation:Record<ResearchTool['validation'],string>={
 'not-evaluated':'Not independently evaluated',
 'under-review':'Scientific review in progress',
 'validated-for-scope':'Validated for stated scope'
};
---
<article class="tool-card mv-tool-card" id={`tool-${tool.id}`} data-availability={state}>
 <div class="eyebrow">{steps.map(s=><span class="mv-tool-step" data-path={s.path}>{s.label}</span>)}{tool.category}</div>
 <h3>{tool.name}</h3>
 <p>{tool.description}</p>
 <div class="mv-tool-status-row" aria-label="Tool status">
  <span class="mv-tool-state" data-state={state}>{stateLabel}</span>
  {available&&<span class="mv-tool-state is-neutral">{maturity[tool.lifecycle]}</span>}
 </div>
 <p class="mv-tool-science"><strong>Scientific status:</strong> {validation[tool.validation]}.</p>
 {tool.limitations.length>0&&<details class="mv-tool-limits"><summary>What this tool cannot establish</summary><ul>{tool.limitations.map(limit=><li>{limit}</li>)}</ul></details>}
 {invitation?<a class="text-link mv-tool-open" href={tool.href}>About the {tool.name} →</a>:available?<a class="text-link mv-tool-open" href={tool.href}>Open the {tool.name} →</a>:<p class="mv-tool-unavailable">This tool is on the development roadmap. No working application is linked yet.</p>}
</article>