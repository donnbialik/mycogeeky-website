---
import '../styles/global.css';
import '../styles/v5.css';
import '../styles/mycoview.css';
import { Image, getImage } from 'astro:assets';
import shareImageSource from '../assets/featured-orange-mushrooms.png';

interface Props { title?: string; description?: string; }
const {
  title = 'MycoView',
  description = 'Explore the fungal world through field discoveries, practical science, open research tools, and people worth meeting.',
} = Astro.props;

const nav = [['Discover','/discover/'],['Learn','/learn/'],['Investigate','/investigate/'],['Connect','/connect/'],['About','/about/']];
const pageTitle = `${title} · MycoView`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image used when a page is shared on Facebook, iNaturalist forums, Discord, etc.
const shareImage = await getImage({ src: shareImageSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareImageUrl = new URL(shareImage.src, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MycoView" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="MycoView home">
        <span class="mycoview-brand-symbol" aria-hidden="true">◉</span>
        <span>MycoView<small>SEE FUNGI DIFFERENTLY.</small></span>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map(([label, url]) => <a href={url} aria-current={Astro.url.pathname === url ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="container footer-inner">
      <span>MycoView · Curiosity, evidence, and connection.</span>
      <span>Guided by MycoGeeky. Built for curious people.</span>
    </div>
  </footer>
</body>
</html>
