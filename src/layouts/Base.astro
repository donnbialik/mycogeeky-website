---
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/shell.css';
import '../styles/sheet.css';
import '../styles/field.css';
import '../styles/lab.css';
import { getImage } from 'astro:assets';
import shareImageSource from '../assets/featured-orange-mushrooms.png';

/** tier: which design tier the page belongs to. 'field' and 'lab' pages show the Field / Lab switch. */
interface Props { title?: string; description?: string; tier?: 'field' | 'lab'; }
const {
  title = 'MycoView',
  description = 'Explore the fungal world through field discoveries, practical science, open research tools, and people worth meeting.',
  tier,
} = Astro.props;
const tierLinks = [['field', 'Field: better collections', '/investigate/field/'], ['lab', 'Lab: taxonomy and research', '/investigate/#workbench']];

const nav = [['Discover','/discover/'],['Learn','/learn/'],['Investigate','/investigate/'],['Connect','/connect/'],['About','/about/']];
const pageTitle = `${title} · MycoView`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image used when a page is shared on Facebook, iNaturalist forums, Discord, etc.
const shareImage = await getImage({ src: shareImageSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareImageUrl = new URL(shareImage.src, Astro.site);
import NewsletterForm from '../components/NewsletterForm.astro';
import { contactEmail, donateUrl, inaturalistProfile, mycogeekyYouTube, mycoviewYouTube, podcastUrl, shopUrl } from '../data/site';
---
<!doctype html>
<html lang="en" data-tier={tier ?? 'field'} data-theme="day">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {tier === 'lab' && <script is:inline>try{var t=localStorage.getItem('mv.labTheme');if(t==='night'||t==='day')document.documentElement.dataset.theme=t;}catch(e){}</script>}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MycoView" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;600;700&display=swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="ds-header">
    <div class="ds-header-inner">
      <a class="ds-brand" href="/" aria-label="MycoView home">
        <span class="ds-wordmark">MYCOVIEW</span>
        <span class="ds-brand-sub">field station, NE Ohio</span>
      </a>
      <nav class="ds-nav" aria-label="Primary navigation">
        {nav.map(([label, url]) => <a href={url} aria-current={Astro.url.pathname.startsWith(url) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <details class="ds-menu">
        <summary aria-label="Menu">Menu
          <svg class="ds-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="ds-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {nav.map(([label, url]) => <a href={url} aria-current={Astro.url.pathname.startsWith(url) ? 'page' : undefined}>{label}</a>)}
        </nav>
      </details>
    </div>
  </header>
  {tier && (
    <div class="ds-tierbar">
      <div class="ds-tierbar-inner">
        <nav class="ds-tierswitch" aria-label="Tier">
          {tierLinks.map(([id, label, url]) => <a href={url} aria-current={tier === id ? 'page' : undefined}>{label}</a>)}
        </nav>
        {tier === 'lab' && (
          <button type="button" class="ds-themetoggle" aria-pressed="false" data-theme-toggle>
            <svg class="ds-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="ds-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <span class="ds-themetoggle-label">Night mode</span>
          </button>
        )}
      </div>
    </div>
  )}
  <main id="main"><slot /></main>
  <footer class="ds-footer">
    <div class="ds-footer-grid">
      <div class="ds-footer-brand">
        <a class="ds-brand" href="/" aria-label="MycoView home"><span class="ds-wordmark">MYCOVIEW</span></a>
        <p>Curiosity, evidence and connection, guided by MycoGeeky. Everything starts with a collection.</p>
        <NewsletterForm tone="dark" id="footer-news" />
      </div>
      <nav class="ds-footer-col" aria-label="Site">
        <h2>Explore</h2>
        {nav.map(([label, url]) => <a href={url}>{label}</a>)}
        <a href="/cultivate/">Cultivate</a>
        <a href="/investigate/#workbench">Research Toolbox</a>
        <a href="/neo-myco/">NEO Myco</a>
      </nav>
      <nav class="ds-footer-col" aria-label="Watch and listen">
        <h2>Watch &amp; listen</h2>
        <a href={mycoviewYouTube}>The MycoView <span class="ds-where">YouTube</span></a>
        <a href={mycogeekyYouTube}>MycoGeeky <span class="ds-where">YouTube</span></a>
        <a href={podcastUrl}>The MycoGeeky Podcast</a>
        <a href={inaturalistProfile}>MycoGeeky on iNaturalist</a>
      </nav>
      <nav class="ds-footer-col" aria-label="Support">
        <h2>Support</h2>
        {shopUrl && <a href={shopUrl}>Shop <span class="ds-where">Etsy</span></a>}
        {donateUrl && <a href={donateUrl}>Donate <span class="ds-where">PayPal</span></a>}
        {contactEmail ? <a href={`mailto:${contactEmail}`}>{contactEmail}</a> : <a href={inaturalistProfile}>Message us on iNaturalist</a>}
      </nav>
    </div>
    <div class="ds-footer-base">
      <span>© {new Date().getFullYear()} MycoView</span>
      <a href="/privacy/">Privacy</a>
    </div>
  </footer>
<script is:inline>
/* Arrival glow: when a link takes you to another part of a page (#anchor) or to a tool card, the place you land
   glows orange for a few seconds so you can see where you are. Also replays when the same link is clicked again.
   Other scripts can call window.mvArrive(element) after scrolling somewhere themselves. */
(function () {
  function arrive(el) {
    if (typeof el === 'string') { try { el = document.getElementById(decodeURIComponent(el)); } catch (e) { el = null; } }
    if (!el || el === document.body || el.tagName === 'MAIN') return;
    el.classList.remove('mv-arrived'); void el.offsetWidth; el.classList.add('mv-arrived');
    clearTimeout(el._mvArrived); el._mvArrived = setTimeout(function () { el.classList.remove('mv-arrived'); }, 4000);
  }
  window.mvArrive = arrive;
  function fromHash() { if (location.hash.length > 1) arrive(location.hash.slice(1)); }
  addEventListener('hashchange', fromHash);
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href*="#"]'); if (!a || a.hasAttribute('data-path-link')) return;
    var u = new URL(a.href, location.href);
    if (u.pathname === location.pathname && u.hash && u.hash === location.hash) setTimeout(function () { arrive(u.hash.slice(1)); }, 60);
  });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fromHash); else fromHash();
})();
</script>
  {tier === 'lab' && <script is:inline>
  (function () {
    var b = document.querySelector('[data-theme-toggle]'); if (!b) return;
    var r = document.documentElement, label = b.querySelector('.ds-themetoggle-label');
    function show() { var night = r.dataset.theme === 'night'; b.setAttribute('aria-pressed', String(night)); label.textContent = night ? 'Day mode' : 'Night mode'; }
    b.addEventListener('click', function () { r.dataset.theme = r.dataset.theme === 'night' ? 'day' : 'night'; try { localStorage.setItem('mv.labTheme', r.dataset.theme); } catch (e) {} show(); });
    show();
  })();
  </script>}
</body>
</html>
