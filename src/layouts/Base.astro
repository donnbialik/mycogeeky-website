---
import '../styles/site.css';
import { getImage } from 'astro:assets';
import shareImageSource from '../assets/featured-orange-mushrooms.png';

interface Props { title?: string; description?: string; }
const {
  title = 'MycoView',
  description = 'Explore the fungal world through field discoveries, practical science, open research tools, and people worth meeting.',
} = Astro.props;

const nav = [['Discover','/discover/'],['Learn','/learn/'],['Investigate','/investigate/'],['Connect','/connect/'],['About','/about/']];
const pageTitle = `${title} · MycoView`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image used when a page is shared on Facebook, iNaturalist forums, Discord, etc.
const shareImage = await getImage({ src: shareImageSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareImageUrl = new URL(shareImage.src, Astro.site);
import NewsletterForm from '../components/NewsletterForm.astro';
import { contactEmail, donateUrl, inaturalistProfile, mycogeekyYouTube, mycoviewYouTube, podcastUrl, shopUrl } from '../data/site';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MycoView" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="MycoView home">
        <span class="mycoview-brand-symbol" aria-hidden="true">◉</span>
        <span>MycoView<small>SEE FUNGI DIFFERENTLY.</small></span>
      </a>
      <details class="mv-mobile-menu"><summary aria-label="Open navigation menu"><span class="mv-menu-label">Menu</span><span class="mv-menu-bars" aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{nav.map(([label,url]) => <a href={url} aria-current={Astro.url.pathname === url ? "page" : undefined}>{label}<span aria-hidden="true">→</span></a>)}</nav></details>
      <nav class="mv-desktop-nav" aria-label="Primary navigation">
        {nav.map(([label, url]) => <a href={url} aria-current={Astro.url.pathname === url ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="mv-footer">
    <div class="container mv-footer-grid">
      <div class="mv-footer-brand">
        <a class="brand" href="/" aria-label="MycoView home"><span class="mycoview-brand-symbol" aria-hidden="true">◉</span><span>MycoView<small>SEE FUNGI DIFFERENTLY.</small></span></a>
        <p>Curiosity, evidence, and connection. Guided by MycoGeeky. Built for curious people.</p>
        <NewsletterForm tone="dark" id="footer-news" />
      </div>
      <nav class="mv-footer-col" aria-label="Site">
        <h2>Explore</h2>
        {nav.map(([label, url]) => <a href={url}>{label}</a>)}
        <a href="/investigate/#workbench">Research Toolbox</a>
        <a href="/neo-myco/">NEO Myco</a>
      </nav>
      <nav class="mv-footer-col" aria-label="Watch and listen">
        <h2>Watch &amp; listen</h2>
        <a href={mycoviewYouTube}>The MycoView on YouTube ↗</a>
        <a href={mycogeekyYouTube}>MycoGeeky on YouTube ↗</a>
        <a href={podcastUrl}>The MycoGeeky Podcast ↗</a>
        <a href={inaturalistProfile}>iNaturalist ↗</a>
      </nav>
      <nav class="mv-footer-col" aria-label="Support">
        <h2>Support</h2>
        {shopUrl && <a href={shopUrl}>Shop on Etsy ↗</a>}
        {donateUrl && <a href={donateUrl}>Donate with PayPal ↗</a>}
        {contactEmail ? <a href={`mailto:${contactEmail}`}>{contactEmail}</a> : <a href={inaturalistProfile}>Message us on iNaturalist ↗</a>}
      </nav>
    </div>
    <div class="container mv-footer-base">
      <span>© {new Date().getFullYear()} Donn Bialik · MycoView</span>
      <a href="/privacy/">Privacy</a>
    </div>
  </footer>
</body>
</html>
