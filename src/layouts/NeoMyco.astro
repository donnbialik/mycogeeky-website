---
import Photo from '../components/Photo.astro';
import '../styles/neomyco.css';
import { getImage } from 'astro:assets';
import shareSource from '../assets/photos/inocybe-communis-front-yard-2023.jpg';
// Preview image when a NEO Myco page is shared: the front-yard Inocybe communis, cropped to 1200 x 630.
const share = await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const {title='NEO Myco — Curiosity, in the field',description='A new Northeast Ohio community for exploring fungi, learning field mycology, and contributing to shared knowledge.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · MycoView</title><meta name="description" content={description}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(share.src,Astro.site)}/><link rel="stylesheet" href="/fonts/neomyco.css" /></head><body><a class="skip" href="#main">Skip to content</a><div class="umbrella"><a href="/">← MycoView</a><span>Curiosity, in the field.</span></div><header><a class="neo-logo" href="/neo-myco/" aria-label="NEO Myco home"><Photo src="neo-myco-logo-light-2027.png" alt="NEO Myco — Northeast Ohio Mycology Collaborative" decoding="async" display={300} quality={90} /></a><nav aria-label="NEO Myco"><a href="/neo-myco/#basics">The basics</a><a href="/neo-myco/#barcoding">Our mission</a><a href="/neo-myco/#field-record">Field record</a><a href="/neo-myco/know-your-woods/">Know Your Woods</a><a class="nav-join" href="/neo-myco/#join">Get updates</a></nav></header><main id="main"><slot/></main><footer><a class="neo-logo neo-logo-footer" href="/neo-myco/" aria-label="NEO Myco home"><Photo src="neo-myco-logo-light-2027.png" alt="NEO Myco — Northeast Ohio Mycology Collaborative" loading="lazy" decoding="async" display={120} quality={90} /></a><p>Explore · Learn · Document · Contribute</p><span class="neo-footer-links"><a href="/privacy/">Privacy</a> · <a href="/">Part of MycoView →</a></span></footer><script>import '../scripts/neo-term.ts';</script></body></html>

<style>
.neo-logo{display:block;flex-shrink:0;width:280px;line-height:0}.neo-logo img{display:block;width:100%;height:auto}.neo-logo-footer{width:110px}@media(max-width:800px){.neo-logo{width:210px}.neo-logo-footer{width:100px}}
header{padding-top:20px;padding-bottom:8px}:global(.hero){padding-top:28px}@media(max-width:800px){header{padding-top:18px;padding-bottom:12px}:global(.hero){padding-top:20px}}
</style>
