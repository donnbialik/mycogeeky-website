---
import '../styles/neomyco.css';
const {title='NeoMyco — Curiosity, in the field',description='A new Northeast Ohio community for exploring fungi, learning field mycology, and contributing to shared knowledge.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · MycoView</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL('https://inaturalist-open-data.s3.amazonaws.com/photos/314765196/large.jpg',Astro.site)}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"/></head><body><a class="skip" href="#main">Skip to content</a><div class="umbrella"><a href="/">← MycoView</a><span>Curiosity, in the field.</span></div><header><a class="neo-logo" href="/neo-myco/" aria-label="NeoMyco home"><img src="/images/field-photography/neo-myco-logo-light-2027.png" alt="Neo Myco — Northeast Ohio Mycology Collaborative" width="1367" height="1150" decoding="async"/></a><nav aria-label="NeoMyco"><a href="/neo-myco/#in-the-field">The idea</a><a href="/neo-myco/#field-record">Field record</a><a href="/neo-myco/know-your-woods/">Know Your Woods</a></nav></header><main id="main"><slot/></main><footer><a class="neo-logo neo-logo-footer" href="/neo-myco/" aria-label="NeoMyco home"><img src="/images/field-photography/neo-myco-logo-light-2027.png" alt="Neo Myco — Northeast Ohio Mycology Collaborative" width="1367" height="1150" loading="lazy" decoding="async"/></a><p>Explore · Learn · Document · Contribute</p><a href="/">Part of MycoView ↗</a></footer></body></html>

<style>
.neo-logo{display:block;flex-shrink:0;width:160px;line-height:0}.neo-logo img{display:block;width:100%;height:auto}.neo-logo-footer{width:110px}@media(max-width:800px){.neo-logo{width:135px}.neo-logo-footer{width:100px}}
</style>
