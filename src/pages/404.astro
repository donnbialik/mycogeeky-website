---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist on MycoView.">
  <section class="station-hero station-hero-solo">
    <div class="station-hero-copy">

    <h1>This trail goes cold.</h1>
    <p class="lead">The page you were looking for isn't here. It may have moved, or the link may be mistyped.</p>
    <div class="station-actions">
      <a class="station-button" href="/">Back to MycoView</a>
      <a class="station-text-link" href="/investigate/">Explore the research</a>
    </div>
    </div>
  </section>
</Base>
