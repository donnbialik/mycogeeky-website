---
import Base from '../layouts/Base.astro';
import { links } from '../data/links';
---
<Base title="Page not found" description="This page doesn't exist on MycoView.">
  <section class="page-hero container not-found">
    <p class="eyebrow">404 · NOTHING FRUITING HERE</p>
    <h1>This trail goes cold.</h1>
    <p class="lead">The page you were looking for isn't here. It may have moved, or the link may be mistyped.</p>
    <p class="not-found-links">
      <a class="button primary" href="/">Back to MycoView →</a>
      <a class="button" href="/investigate/">Explore the research</a>
      <a class="button" href={links.youtube.url} target="_blank" rel="noopener noreferrer">Watch The MycoView ↗</a>
    </p>
  </section>
</Base>
