---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import SupportBlock from '../../components/SupportBlock.astro';
import { Image } from 'astro:assets';
import neoMycoLogo from '../../assets/logos/neo-myco-logo-dark-2027.png';
---
<Base title="Connect"><div class="station-page">
<section class="station-hero station-hero-split"><div class="station-hero-copy"><p class="eyebrow">CONNECT / SCIENCE IS A TEAM SPORT</p><h1>Find your <em>people.</em></h1><p class="lead">A great observation might start with one person. The most interesting discoveries often begin when people share questions, methods, evidence, and credit.</p><a class="station-button" href="#community">Find a way in ↓</a></div><Photo src="myco-friends-1.jpg" alt="Friends brought together by shared curiosity about fungi" loading="eager" decoding="async" /></section>
<section class="station-content" id="community"><div class="station-section-head"><h2>MAKE A CONNECTION</h2><span>PEOPLE / PROJECTS / CONTRIBUTIONS</span></div><div class="station-editorial-grid">
<a class="station-editorial-card" href="/neo-myco/"><Image class="connect-logo" src={neoMycoLogo} alt="NEO Myco — Northeast Ohio Mycology Collaborative, established 2027" widths={[480,800]} sizes="(max-width: 700px) 100vw, 400px" format="webp" quality={82} loading="lazy" decoding="async"/><span class="station-card-body"><small>REGIONAL SCIENCE</small><strong>NEO Myco</strong><span>A Northeast Ohio community launching in 2027: forays, workshops, and citizen-science projects, including DNA barcoding.</span><b>Discover NEO Myco →</b></span></a>
<a class="station-editorial-card" href="/investigate/learn/#surveys"><Photo src="community-mushroom-identification-table.jpg" class="connect-survey" alt="Community mycologists examining mushroom collections together" loading="lazy" decoding="async" /><span class="station-card-body"><small>JOIN THE WORK</small><strong>Community field surveys</strong><span>See how observations and repeat visits can become useful biodiversity records.</span><b>Explore projects →</b></span></a>
<a class="station-editorial-card" href="/investigate/learn/"><Photo src="mycogeeky-microscopy-research.jpeg" class="connect-microscopy" alt="MycoGeeky examining fungi with a microscope beside a research laptop" loading="lazy" decoding="async" /><span class="station-card-body"><small>PEOPLE DOING THE WORK</small><strong>Find your role in mycology</strong><span>Discover research disciplines and ways to contribute at any experience level.</span><b>Find an entry point →</b></span></a>
</div></section>
<SupportBlock id="support" />
</div></Base>
<style>
.station-editorial-card > img { width: 100%; height: clamp(190px, 19vw, 260px); object-fit: cover; }
.station-editorial-card > img.connect-logo { object-fit: contain; background: #000; padding: 12px; box-sizing: border-box; }
.station-editorial-card > img.connect-survey { object-position: center 55%; }
.station-editorial-card > img.connect-microscopy { object-position: center 42%; }
@media (max-width: 700px) { .station-editorial-card > img { height: 230px; } }
</style>
