---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import macro from '../../assets/pathways/curious.jpg';
import field from '../../assets/pathways/investigate.jpg';
import people from '../../assets/pathways/connect.jpg';
import woodland from '../../assets/pathways/explore.jpg';
import orange from '../../assets/featured-orange-mushrooms.png';
---
<Base title="Discover" description="Fungal mysteries, new scientific discoveries, field stories and the questions worth following.">
<div class="discover-home">
  <section class="discover-lead">
    <div class="discover-lead-copy">
      <p class="discover-kicker">DISCOVER / STORIES FROM THE FUNGAL WORLD</p>
      <h1>There's more out there <em>than we know.</em></h1>
      <p>Strange organisms. Surprising research. People asking questions nobody has answered yet. Come find something worth wondering about.</p>
      <a href="#featured-discovery" class="discover-lead-link">Explore the featured discovery ↓</a>
    </div>
    <div class="discover-quilt" aria-label="A photographic field-journal quilt of sixteen fungal and forest details">
      <figure class="quilt-tile"><Image src={macro} alt="Pink cup fungi" loading="eager" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={orange} alt="Crust fungi on wood" loading="eager" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={macro} alt="Tiny fungi emerging" loading="eager" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={orange} alt="Coral fungus" loading="eager" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={field} alt="Toothed mushroom" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={woodland} alt="Bracket fungus" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={people} alt="Delicate forest mushrooms" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={orange} alt="Mossy woodland fungi" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={woodland} alt="Clusters on fallen wood" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={macro} alt="Layered bracket fungi" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={orange} alt="Yellow jelly fungus" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={field} alt="Brown mushrooms on wood" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={macro} alt="Purple mushroom gills" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={people} alt="Small puffballs" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={woodland} alt="Forest floor mushrooms" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
      <figure class="quilt-tile"><Image src={field} alt="Moss-covered log fungi" loading="lazy" widths={[240,480]} sizes="(max-width:850px) 25vw, 12vw" /></figure>
    </div>
  </section>
  <section class="discover-feature" id="featured-discovery" aria-labelledby="discover-feature-title">
    <a class="discover-feature-photo" href="/discover/devils-fingers/" aria-label="Read Did the devil's fingers really move?">
      <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Clathrus_archeri_100906693.jpg" alt="Clathrus archeri, a fungus with bright red finger-like arms" loading="eager"/>
    </a>
    <div class="discover-feature-copy">
      <p class="discover-kicker">FEATURED DISCOVERY / BIODIVERSITY &amp; EVIDENCE</p>
      <h2 id="discover-feature-title">Did the devil's fingers <em>really move?</em></h2>
      <p>One unusual fungus. An observation near Kyiv. A 350-kilometer gap in the documented record. But did the fungus arrive somewhere new—or did we finally notice what was already there?</p>
      <a class="discover-main-link" href="/discover/devils-fingers/">Read the discovery →</a>
      <a class="discover-minor-link" href="/investigate/case-studies/clathrus-archeri/">Already know the story? Investigate the evidence ↗</a>
      <p class="discover-credit">Illustrative photo, not from the Ukrainian study. Matteo Marcandella · <a href="https://commons.wikimedia.org/wiki/File:Clathrus_archeri_100906693.jpg">CC BY 4.0</a></p>
    </div>
  </section>
  <section class="discover-bottom">
    <div class="discover-bottom-head"><p class="discover-kicker">WHAT YOU'LL FIND HERE</p><h2>Follow what makes you curious.</h2><p>Discover is MycoView's editorial home: selected scientific discoveries, field observations, unanswered questions, and the people investigating them. We choose stories for their substance, not just their novelty.</p></div>
    <div class="discover-pillars">
      <div><span>01 / RESEARCH &amp; DISCOVERIES</span><h3>From the fungal world</h3><p>New studies and remarkable findings, explained with sources, context, and the limits of what we know.</p></div>
      <div><span>02 / FIELD NOTES</span><h3>Closer to the ground</h3><p>Unusual observations and the questions that emerge when people pay attention.</p></div>
      <div><span>03 / PEOPLE &amp; PERSPECTIVES</span><h3>Curiosity is contagious</h3><p>The researchers, naturalists, and collaborators who make fungal exploration a shared adventure.</p></div>
    </div>
    <p class="discover-future">We're beginning with one fully developed discovery. More stories will appear as they're researched and ready—not as empty placeholders.</p>
  </section>
</div>
</Base>
<style>
.discover-home{background:#f8f7f1;color:#17372e}.discover-kicker{font:600 .7rem "IBM Plex Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:#64806b}.discover-lead{background:#10382c;color:#f6f7eb;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(250px,.5fr);align-items:end;gap:40px;padding:clamp(55px,7vw,115px) max(28px,calc((100vw - 1400px)/2)) 70px}.discover-lead .discover-kicker{color:#c7d8a7}.discover-lead h1{font:600 clamp(3.7rem,6.5vw,7rem)/1.02 "Source Serif 4",Georgia,serif;letter-spacing:-.04em;max-width:950px;margin:26px 0}.discover-lead h1 em,.discover-feature h2 em{font-weight:500;color:#d8eb9a}.discover-lead-copy>p:not(.discover-kicker){font-size:clamp(1.1rem,1.4vw,1.4rem);line-height:1.6;max-width:660px;color:#e4eee4}.discover-lead-link{display:inline-block;margin-top:22px;background:#d8ec62;padding:14px 20px;border-radius:4px;color:#143b2d;font-weight:700;text-decoration:none}.discover-lead-side{border-top:1px solid #789384;padding-top:20px;max-width:300px}.discover-lead-side span{font:600 .67rem "IBM Plex Mono",monospace;letter-spacing:.09em;color:#c8d7a7}.discover-lead-side p{font:500 1.35rem/1.4 "Source Serif 4",Georgia,serif}.discover-feature{max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);padding:70px 30px;gap:clamp(28px,5vw,75px);align-items:center}.discover-feature-photo{display:block;overflow:hidden;background:#254537;min-height:450px}.discover-feature-photo img{display:block;width:100%;height:100%;min-height:450px;max-height:650px;object-fit:cover;object-position:center 48%;transition:transform .3s}.discover-feature-photo:hover img{transform:scale(1.025)}.discover-feature h2{font:600 clamp(2.9rem,4.4vw,5.2rem)/1.07 "Source Serif 4",Georgia,serif;letter-spacing:-.035em;margin:18px 0}.discover-feature h2 em{color:#547748}.discover-feature-copy>p:not(.discover-kicker):not(.discover-credit){font-size:1.14rem;line-height:1.7;max-width:520px}.discover-main-link{display:inline-block;background:#173d2f;color:#fff;padding:14px 22px;border-radius:4px;text-decoration:none;font-weight:700;margin:18px 0 12px}.discover-minor-link{display:block;color:#20523d;font-size:.87rem;font-weight:600;text-underline-offset:4px}.discover-feature .discover-credit{font-size:.73rem;line-height:1.5;color:#657468;margin-top:35px}.discover-credit a{color:inherit}.discover-bottom{background:#e8ede3;padding:75px 30px}.discover-bottom-head,.discover-pillars,.discover-future{max-width:1350px;margin-left:auto;margin-right:auto}.discover-bottom-head h2{font:600 clamp(2.4rem,4vw,4rem)/1.12 "Source Serif 4",Georgia,serif;margin:12px 0}.discover-bottom-head>p:last-child{max-width:740px;line-height:1.7}.discover-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:36px}.discover-pillars>div{padding:30px;background:#f8f7f1;border-top:4px solid #8ca66e}.discover-pillars span{font:600 .66rem "IBM Plex Mono",monospace;color:#55745a;letter-spacing:.08em}.discover-pillars h3{font:600 1.9rem "Source Serif 4",Georgia,serif;margin:18px 0 12px}.discover-pillars p{line-height:1.65;color:#52645a}.discover-future{font-size:.83rem;color:#52675a;margin-top:26px}.discover-home a:focus-visible{outline:3px solid #b6c958;outline-offset:4px}@media(max-width:850px){.discover-lead{grid-template-columns:1fr;padding:50px 25px}.discover-lead-side{max-width:600px}.discover-feature{grid-template-columns:1fr;padding:42px 20px}.discover-feature-photo,.discover-feature-photo img{min-height:320px;max-height:470px}.discover-pillars{grid-template-columns:1fr}.discover-bottom{padding:50px 20px}}@media(max-width:480px){.discover-lead h1{font-size:3.4rem}.discover-feature h2{font-size:2.8rem}.discover-feature-photo,.discover-feature-photo img{min-height:280px;height:280px}}
</style>
<style>
.discover-lead{grid-template-columns:minmax(0,1.02fr) minmax(0,1fr);gap:clamp(25px,4vw,65px);align-items:center;min-height:0;padding-top:50px;padding-bottom:52px}
.discover-lead-copy{min-width:0}
.discover-lead h1{font-size:clamp(3.8rem,5.1vw,6.2rem);max-width:800px}
.discover-visual{display:grid;grid-template-columns:minmax(0,1.32fr) minmax(0,.8fr);grid-template-rows:220px 220px auto;gap:12px;min-width:0}
.discover-visual figure{margin:0;min-width:0;position:relative;overflow:hidden;background:#315542}
.discover-visual img{display:block;width:100%;height:100%;object-fit:cover}
.discover-visual-main{grid-row:1 / 3;grid-column:1}
.discover-visual-main img{object-position:center center}
.discover-visual-field{grid-row:1;grid-column:2}
.discover-visual-people{grid-row:2;grid-column:2}
.discover-visual figcaption{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;gap:8px;background:linear-gradient(transparent,#0d2b21dc);color:#f1f4e6;padding:26px 12px 11px;font:700 .59rem "IBM Plex Mono",monospace;letter-spacing:.08em}
.discover-visual-caption{grid-column:1/-1;display:flex;align-items:baseline;justify-content:space-between;gap:20px;border-top:1px solid #6b8978;padding-top:13px;color:#d6e4cf}
.discover-visual-marker{white-space:nowrap;color:#d8eb9a;font:700 .61rem "IBM Plex Mono",monospace;letter-spacing:.1em}
.discover-visual-caption p{margin:0;font:500 1.1rem/1.35 "Source Serif 4",Georgia,serif;text-align:right}
@media(max-width:1100px){.discover-lead{gap:26px}.discover-visual{grid-template-rows:170px 170px auto}.discover-lead h1{font-size:clamp(3.5rem,5vw,5.3rem)}}
@media(max-width:850px){.discover-lead{grid-template-columns:1fr;padding:42px 25px 48px;gap:28px}.discover-visual{max-width:750px;width:100%;grid-template-rows:210px 210px auto}.discover-lead h1{font-size:clamp(3.6rem,8vw,5.6rem)}}
@media(max-width:480px){.discover-lead h1{font-size:3.3rem}.discover-visual{grid-template-rows:155px 155px auto;gap:7px}.discover-visual figcaption{font-size:.48rem;padding:20px 7px 7px}.discover-visual-caption{display:block}.discover-visual-caption p{text-align:left;margin-top:6px}}
</style>

<style>
/* The Discover mosaic: one cohesive photographic quilt, not overlapping cards. */
.discover-lead{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,4vw,65px);padding-top:38px;padding-bottom:42px;align-items:center}
.discover-lead h1{font-size:clamp(3.6rem,4.8vw,6rem)}
.discover-quilt{display:grid;grid-template-columns:1.2fr 1fr .85fr;grid-template-rows:145px 145px 145px auto;gap:7px;min-width:0}
.discover-quilt .quilt-tile{position:relative;overflow:hidden;margin:0;min-width:0;background:#315542}
.discover-quilt .quilt-tile img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s ease}
.discover-quilt .quilt-tile:hover img{transform:scale(1.035)}
.discover-quilt .quilt-tile figcaption{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,#08241bc9);padding:22px 10px 9px;color:#f2f4e9;font:700 .55rem "IBM Plex Mono",monospace;letter-spacing:.08em}
.discover-quilt .quilt-macro{grid-column:1;grid-row:1/3}
.discover-quilt .quilt-orange{grid-column:2;grid-row:1}
.discover-quilt .quilt-field{grid-column:3;grid-row:1/3}
.discover-quilt .quilt-woodland{grid-column:1;grid-row:3}
.discover-quilt .quilt-people{grid-column:2;grid-row:2/4}
.discover-quilt .quilt-devils{grid-column:3;grid-row:3}
.discover-quilt .quilt-foot{grid-column:1/-1}
.discover-quilt-foot{grid-column:1/-1;display:flex;justify-content:space-between;gap:12px;padding-top:10px;color:#c3d4b3;font:700 .56rem "IBM Plex Mono",monospace;letter-spacing:.09em}
@media(max-width:1100px){.discover-quilt{grid-template-rows:120px 120px 120px auto}.discover-lead h1{font-size:clamp(3.4rem,4.9vw,5.2rem)}}
@media(max-width:850px){.discover-lead{grid-template-columns:1fr;padding:38px 24px 42px;gap:27px}.discover-quilt{grid-template-rows:clamp(90px,22vw,150px) clamp(90px,22vw,150px) clamp(90px,22vw,150px) auto;max-width:760px;width:100%;margin:auto}.discover-lead h1{font-size:clamp(3.5rem,8vw,5.5rem)}}
@media(max-width:480px){.discover-quilt{gap:5px;grid-template-rows:90px 90px 90px auto}.discover-quilt .quilt-tile figcaption{font-size:.43rem;padding:16px 5px 5px}.discover-quilt-foot{font-size:.43rem;flex-wrap:wrap}.discover-lead h1{font-size:3.2rem}}
@media(prefers-reduced-motion:reduce){.discover-quilt .quilt-tile img{transition:none}}
</style>
<style>
/* Editorial field-journal quilt: four columns, sixteen equal photographic windows. */
.discover-lead{grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:clamp(28px,3.4vw,60px);padding-top:38px;padding-bottom:38px}
.discover-lead h1{font-size:clamp(3.45rem,4.55vw,5.75rem)}
.discover-quilt{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(4,minmax(0,1fr));gap:5px;aspect-ratio:1.7;width:100%;min-width:0}
.discover-quilt .quilt-tile{grid-column:auto!important;grid-row:auto!important;min-height:0;overflow:hidden;margin:0;background:#254637;border-radius:2px}
.discover-quilt .quilt-tile img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .35s ease}
.discover-quilt .quilt-tile:nth-child(4n+2) img{object-position:35% center}
.discover-quilt .quilt-tile:nth-child(4n+3) img{object-position:70% center}
.discover-quilt .quilt-tile:hover img{transform:scale(1.055)}
@media(max-width:850px){.discover-lead{grid-template-columns:1fr}.discover-quilt{aspect-ratio:1.6;max-width:760px}}
@media(max-width:480px){.discover-quilt{gap:3px;aspect-ratio:1.15}}
@media(prefers-reduced-motion:reduce){.discover-quilt .quilt-tile img{transition:none}}
</style>
