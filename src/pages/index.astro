---
import Base from '../layouts/Base.astro';
import FeaturedHero from '../components/FeaturedHero.astro';
import CuriosityGenerator from '../components/CuriosityGenerator';
import { Image } from 'astro:assets';
import explore from '../assets/pathways/explore.jpg';
import curious from '../assets/pathways/curious.jpg';
import investigate from '../assets/pathways/investigate.jpg';
import connect from '../assets/pathways/connect.jpg';


const pathways = [
  { title: 'Explore', href: '/explore/', image: explore, alt: 'Dramatic rocky landscape encountered during a field adventure', description: 'Stories, field notes, and real-world mushroom adventures.' },
  { title: 'Get Curious', href: '/curious/', image: curious, alt: 'Intricate purple mushroom underside viewed up close', description: 'Interactive mysteries, observation games, and hands-on learning.' },
  { title: 'Investigate', href: '/investigate/', image: investigate, alt: 'Camera documenting wild mushrooms in the field', description: 'Tools, data, and research resources for all levels.' },
  { title: 'Connect', href: '/connect/', image: connect, alt: 'Naturalists examining discoveries together in the woods', description: 'Find collaborators, share observations, and join the community.' },
];
---
<Base title="Stay Curious. Stay Cultivating." description="MycoGeeky is where curious mushroom people learn to do real mycology: field observation, microscopy, DNA barcoding, and the questions that lead to new species.">
  <FeaturedHero />
  <section class="home-pathways" aria-label="Ways to explore MycoGeeky">
    <div class="container home-pathway-grid">
      {pathways.map((p) => (
        <a href={p.href} class="home-pathway" aria-label={`${p.title}: ${p.description}`}>
          <Image src={p.image} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 50vw, (max-width: 900px) 45vw, 280px" format="webp" quality={72} loading="lazy" />
          <span class="home-pathway-content"><span class="home-pathway-title">{p.title} <span class="pathway-arrow" aria-hidden="true"></span></span><span class="home-pathway-description">{p.description}</span></span>
        </a>
      ))}
    </div>
  </section>
  <section class="section curiosity-section" aria-labelledby="curiosity-section-title"><div class="container curiosity-section-grid"><div><p class="eyebrow">LOOK A LITTLE CLOSER</p><h2 id="curiosity-section-title">Curiosity is something you do.</h2><p>You don’t need to know the name of a mushroom to discover something interesting about it. Start with a small challenge, then follow the questions wherever they lead.</p></div><CuriosityGenerator client:visible /></div></section>
  <section class="section soft home-deeper" aria-labelledby="home-deeper-title">
    <div class="container">
      <div class="home-deeper-intro">
        <div><p class="eyebrow">GO DEEPER · REAL QUESTIONS, REAL EVIDENCE</p><h2 id="home-deeper-title">Curiosity can become research.</h2>
          <p>It might begin with a mushroom you can't name, a place you return to every season, or a DNA sequence that raises more questions than it answers. You don't have to choose between wonder and scientific rigor.</p>
        </div>
        <a class="button primary" href="/investigate/learn/">What is fungal research? <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-deeper-grid">
        <a class="home-deeper-card" href="/investigate/learn/#ways"><span class="eyebrow">SIX WAYS INTO THE SCIENCE</span><h3>Find your kind of question.</h3><p>Field surveys, taxonomy, DNA, ecology, microscopy, and scientific collections. See what each looks like—and where I contribute.</p><span class="home-deeper-link">Explore the research fields →</span></a>
        <a class="home-deeper-card" href="/investigate/learn/#closer"><span class="eyebrow">CLOSER TO HOME</span><h3>From observations to collaboration.</h3><p>Follow the projects, people, and open questions shaping my own work in mycology, including NEO MYCO.</p><span class="home-deeper-link">Read the story →</span></a>
        <a class="home-deeper-card" href="/investigate/learn/#closer"><span class="eyebrow">LONG-TERM FIELDWORK</span><h3>What changes when you keep looking?</h3><p>Repeated surveys can reveal seasonal patterns, missed species, and changing forests. Explore why the same places are worth visiting year after year.</p><span class="home-deeper-link">See the survey approach →</span></a>
      </div>
      <div class="home-deeper-bottom"><p>Want to work with the evidence yourself?</p><a href="/investigate/tools/">Open the Research Workbench →</a><a href="/investigate/resources/">Browse research resources →</a></div>
    </div>
  </section>
  <section class="section home-media" aria-labelledby="home-media-title">
    <div class="container">
      <div class="home-media-heading"><div><p class="eyebrow">CONVERSATIONS AND STORIES</p><h2 id="home-media-title">See what we're exploring.</h2></div><p>Research conversations, field stories, and the people who make mycology worth sharing.</p></div>
      <div class="home-media-grid">
        <article class="home-media-card"><span class="eyebrow">THE MYCOVIEW</span><h3>New perspectives on fungal science.</h3><p>Field observations, discoveries, and the questions that connect curious people to research.</p><p class="home-media-pending">Episode links and thumbnails coming soon.</p></article>
        <article class="home-media-card"><span class="eyebrow">THE MYCOGEEKY PODCAST</span><h3>Conversations from the mycosphere.</h3><p>Long-form discussions with the people exploring fungi from many different angles.</p><p class="home-media-pending">Episode links and thumbnails coming soon.</p></article>
      </div>
    </div>
  </section>
</Base>
