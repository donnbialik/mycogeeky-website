---
import Base from '../layouts/Base.astro';
import FeaturedHero from '../components/FeaturedHero.astro';
import QuestionPicker from '../components/QuestionPicker';
---
<Base title="Stay Curious. Stay Cultivating.">
  <FeaturedHero />
  <section class="home-pathways" aria-label="Ways to explore MycoGeeky">
    <div class="container home-pathway-grid">
      <a href="/explore/" class="home-pathway"><span class="pathway-icon" aria-hidden="true">⌕</span><h2>Explore</h2><p>Stories, field notes, and real-world mushroom adventures.</p><span class="pathway-link">Dive in →</span></a>
      <a href="/curious/" class="home-pathway"><span class="pathway-icon" aria-hidden="true">✳</span><h2>Get Curious</h2><p>Interactive mysteries, observation games, and hands-on learning.</p><span class="pathway-link">Play & learn →</span></a>
      <a href="/investigate/" class="home-pathway"><span class="pathway-icon" aria-hidden="true">⚗</span><h2>Investigate</h2><p>Tools, data, and research resources for all levels.</p><span class="pathway-link">Start exploring →</span></a>
      <a href="/connect/" class="home-pathway"><span class="pathway-icon" aria-hidden="true">♧</span><h2>Connect</h2><p>Find collaborators, share observations, and join the community.</p><span class="pathway-link">Find your people →</span></a>
    </div>
  </section>
  <section class="section soft"><div class="container split"><div><p class="eyebrow">THE QUESTION IS THE BEGINNING</p><h2>You don't need permission to be curious.</h2><p>Take science seriously without taking yourself too seriously. Respect expertise, examine evidence, and make room for people who want to contribute.</p></div><QuestionPicker client:load /></div></section>
</Base>
