---
import Base from '../layouts/Base.astro';
import FeaturedHero from '../components/FeaturedHero.astro';
import QuestionPicker from '../components/QuestionPicker';
import CuriosityGenerator from '../components/CuriosityGenerator';
---
<Base title="Stay Curious. Stay Cultivating.">
  <FeaturedHero />
  <section class="home-pathways" aria-label="Ways to explore MycoGeeky">
    <div class="container home-pathway-grid">
      <a href="/explore/" class="home-pathway" aria-label="Explore: Stories, field notes, and real-world mushroom adventures.">
        <img src="/images/pathways/explore.jpg" alt="Dramatic rocky landscape encountered during a field adventure" loading="lazy" />
        <span class="home-pathway-content"><span class="home-pathway-title">Explore <span class="pathway-arrow" aria-hidden="true"></span></span><span class="home-pathway-description">Stories, field notes, and real-world mushroom adventures.</span></span>
      </a>
      <a href="/curious/" class="home-pathway" aria-label="Get Curious: Interactive mysteries, observation games, and hands-on learning.">
        <img src="/images/pathways/curious.jpg" alt="Intricate purple mushroom underside viewed up close" loading="lazy" />
        <span class="home-pathway-content"><span class="home-pathway-title">Get Curious <span class="pathway-arrow" aria-hidden="true"></span></span><span class="home-pathway-description">Interactive mysteries, observation games, and hands-on learning.</span></span>
      </a>
      <a href="/investigate/" class="home-pathway" aria-label="Investigate: Tools, data, and research resources for all levels.">
        <img src="/images/pathways/investigate.jpg" alt="Camera documenting wild mushrooms in the field" loading="lazy" />
        <span class="home-pathway-content"><span class="home-pathway-title">Investigate <span class="pathway-arrow" aria-hidden="true"></span></span><span class="home-pathway-description">Tools, data, and research resources for all levels.</span></span>
      </a>
      <a href="/connect/" class="home-pathway" aria-label="Connect: Find collaborators, share observations, and join the community.">
        <img src="/images/pathways/connect.jpg" alt="Naturalists examining discoveries together in the woods" loading="lazy" />
        <span class="home-pathway-content"><span class="home-pathway-title">Connect <span class="pathway-arrow" aria-hidden="true"></span></span><span class="home-pathway-description">Find collaborators, share observations, and join the community.</span></span>
      </a>
    </div>
  </section>
  <section class="section curiosity-section" aria-labelledby="curiosity-section-title"><div class="container curiosity-section-grid"><div><p class="eyebrow">LOOK A LITTLE CLOSER</p><h2 id="curiosity-section-title">Curiosity is something you do.</h2><p>You don’t need to know the name of a mushroom to discover something interesting about it. Start with a small challenge, then follow the questions wherever they lead.</p></div><CuriosityGenerator client:load /></div></section>
  <section class="section soft"><div class="container split"><div><p class="eyebrow">THE QUESTION IS THE BEGINNING</p><h2>You don't need permission to be curious.</h2><p>Take science seriously without taking yourself too seriously. Respect expertise, examine evidence, and make room for people who want to contribute.</p></div><QuestionPicker client:load /></div></section>
</Base>
