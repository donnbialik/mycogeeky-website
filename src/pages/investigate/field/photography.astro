// Phone photography for identification: the shot list, getting it in focus, and checking before you leave.
const sources = [
  { cite: 'FunDiS. <em>Photograph &amp; collect</em> (show cap, gill or pore surface, stem, bulb or volva, staining; scale; host or substrate).', url: 'https://fundis.org/sequence/document/collect-photograph/' },
  { cite: 'FunDiS. <em>Photography of macrofungi: an in-depth look</em> (all sides, scale, close-ups, the base, colour changes over time).', url: 'https://www.fundis.org/blog/photography-of-macrofungi' },
  { cite: 'University of Kentucky Forestry Extension. <em>Tips for taking mushroom photos for identification</em> (FORFS 24-10).', url: 'https://forestry.ca.uky.edu/sites/forestry.ca.uky.edu/files/forfs%2024-10.pdf' },
  { cite: 'Apple iPhone tips: tap to focus, and touch and hold for AE/AF Lock (iMore).', url: 'https://www.imore.com/how-get-most-sharp-and-focused-photos-iphone-photography-tips-and-tricks' },
  { cite: 'Engadget. <em>How to improve your smartphone photography</em> (use each camera at its native zoom; avoid in-between digital zoom).', url: 'https://www.engadget.com/cameras/how-to-improve-your-smartphone-photography-010037588.html' },
  { cite: 'Popsa. <em>Android macro photography guide</em> (many Android phones switch to macro mode automatically up close).', url: 'https://popsa.com/perspectives/android-macro-photography-guide/' },
  { cite: 'iNaturalist. <em>Smartphone Photography for iNaturalist</em> (blog, August 2026).', url: 'https://www.inaturalist.org/blog/134313-smartphone-photography-for-inaturalist' },
];
const tour = [
  { title: 'Phone photos that can be identified', body: '<p>Most unidentifiable observations aren’t bad mushrooms, they’re missing views or out of focus. This walk-through covers the shots to take, how to get them sharp on a phone, and a ten-second check before you walk away.</p>' },
  { sel: '#shots', title: 'The shot list', body: '<p>Top, underside, side profile, the whole base, a cut section, and the habitat. The base and underside are the ones people skip.</p>' },
  { sel: '#focus', title: 'Getting it sharp', body: '<p>Tap the part that matters, lock focus, and don’t move closer afterwards. Use your phone’s real lenses rather than pinch-zooming.</p>' },
  { sel: '#light', title: 'Light and colour', body: '<p>Even light, no harsh sun or flash glare, and a slip or card in frame. Colour is evidence, and some of it fades within minutes.</p>' },
  { sel: '#check', title: 'Check before you leave', body: '<p>Zoom into one photo on the screen. If the gills aren’t crisp at full size, retake it now: you can’t go back for it later.</p>' },
];
const shots = [
  ['In place', 'Before you touch it: the mushroom where it grew, with the host tree, wood or soil visible.', '1'],
  ['Top of the cap', 'Colour, texture, scales or warts, sliminess. A slight angle often shows texture better than straight down.', '1'],
  ['Underside', 'Gills, pores or teeth, and how they meet the stem. This is the most commonly missing photo.', '1'],
  ['Side profile', 'Cap shape, stem shape, any ring. Lay it on the ground or hold it up.', '2'],
  ['The whole base', 'Dig it out, don’t snap it off. Bulbs, cups (volvas) and rooting bases are often underground.', '1'],
  ['Cut in half', 'Top to bottom through cap and stem: flesh colour, hollow or solid stem, and any colour change. Photograph it again after a few minutes if it changes.', '2'],
