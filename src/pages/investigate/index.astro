---
import Base from '../../layouts/Base.astro';import ToolCard from '../../components/ToolCard.astro';import {activeTools} from '../../data/tools';
---
<Base title="Investigate Fungi"><section class="page-hero container"><p class="eyebrow">INVESTIGATE / SCIENCE IS SOMETHING YOU CAN DO</p><h1>Follow the evidence.</h1><p class="lead">Learn what fungal research looks like, explore the resources scientists use, or open a workbench tool and get to work.</p></section><section class="section"><div class="container"><div class="feature-grid three"><a class="feature" href="/investigate/learn/"><span>START HERE, IF YOU LIKE</span><h3>Learn the process</h3><p>Questions, methods, practice datasets and the uncertainty in between.</p></a><a class="feature" href="/investigate/tools/"><span>WORK ON YOUR OWN QUESTION</span><h3>Research Workbench</h3><p>Discover practical tools with clear maturity and validation labels.</p></a><a class="feature" href="/investigate/resources/"><span>FIND THE ORIGINAL EVIDENCE</span><h3>Research resources</h3><p>iNaturalist, GBIF, GenBank, BLAST, publications and specimen records.</p></a></div></div></section><section class="section soft"><div class="container"><p class="eyebrow">WORKBENCH PREVIEW</p><h2>Tools that evolve with the questions.</h2><div class="feature-grid three">{activeTools.map(tool=><ToolCard tool={tool}/>)}</div></div></section></Base>
