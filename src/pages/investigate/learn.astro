const surveySites=[
{name:'Cuyahoga Valley National Park',role:'Collecting permit · longitudinal fungal survey'},
{name:'Cleveland Metroparks',role:'Collecting permit · longitudinal fungal survey'},
{name:'Summit Metro Parks',role:'Collecting permit · longitudinal fungal survey'},
{name:'Crane Hollow Nature Preserve',role:'Contributor to an ongoing survey'}
];
const surveyWhy=[
{title:'One visit sees only a fraction.',text:'A mushroom is a brief fruiting of a fungus that lives mostly out of sight, and many species fruit only in certain years or weather. A site’s species list keeps growing for years before it levels off. Only repeat visits show what is actually there.'},
{title:'A baseline makes change visible.',text:'You can’t say a fungus has declined, arrived, or shifted its season without records from before. Every year of careful survey becomes the “before” that future comparisons depend on.'},
{title:'These forests are changing now.',text:'Beech leaf disease, first found in Northeast Ohio in 2012, is spreading through local beech forests, and hemlock woolly adelgid has reached the Hocking Hills. Fungi that partner with those trees may change with them. Without earlier records, nobody would know.'},
{title:'Vouchers and DNA turn sightings into evidence.',text:'Permits allow collections to be preserved and sequenced, so identifications can be checked by others and revisited as taxonomy changes, sometimes decades later.'},
{title:'It gives land managers something to work with.',text:'Fungi are still rarely included in conservation planning. Documented records, especially of rare or undescribed species, give park and preserve staff real data about what they are protecting.'}
];
const paths=[
{title:'I like finding mushrooms',start:'Record one careful observation: multiple angles, habitat, substrate, date and location.',grow:'Return to the site, compare seasons, and ask whether a voucher would help.'},
{title:'I like microscopes and details',start:'Document spores, basidia, cystidia or other diagnostic features with measurements and scale.',grow:'Compare descriptions and share well-annotated evidence with a taxonomic project.'},
