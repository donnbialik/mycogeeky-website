{number:'05',title:'Microscopy, cultures & physiology',question:'How are fungi built, and how do they grow?',action:'Document microscopic structures, investigate growth under controlled conditions, and contribute reproducible culture observations where safe and lawful.',lead:'Learn experimental design and specimen documentation.',links:[],tail:'',example:null},
{number:'06',title:'Collections, data & scientific communication',question:'How do discoveries become lasting evidence?',action:'Prepare voucher labels, transcribe historical specimens, clean biodiversity data, build open tools, make illustrations or translate research for others.',lead:'Visit',links:[['MyCoPortal','https://www.mycoportal.org'],['the literature directory','/investigate/resources/'],['the Research Workbench','/investigate/tools/']],tail:'',example:'#ampg'}
