const story=[
{tag:'My path',title:'From observations to sequences on iNaturalist',status:'Ongoing',
 body:['What started as documenting mushrooms on iNaturalist eventually led to DNA sequencing, new friendships, and some interesting taxonomic questions—including one involving an Amanita growing in my front yard.'],
 link:['@mycogeekyohio on iNaturalist','https://www.inaturalist.org/people/mycogeekyohio'],draft:false},
{tag:'Publishing',title:'Amateur Mycology Publishing Group',status:'Video coming soon',
 body:['Scott Ostuni and Kyle Canan’s efforts to investigate provisional fungal taxa grew into a small group of amateur mycologists learning the process of taxonomic research together. Being part of that group helped shape my journey and inspired The MycoView and this website.'],
 youtubeId:'',draft:false},
{tag:'Coming in 2027',title:'NEO MYCO',status:'Launching 2027',
 body:['A new regional, NAMA-affiliated mushroom club for Northeast Ohio, built around community science and DNA barcoding.','[One or two lines on what will make it different, and how people can get involved.] NEO MYCO will have its own website.'],
