{project:'MycoMap BC',names:'Regional MycoMap BC collaborators',role:'Community-led regional sequencing',photo:'',photoCredit:'',profile:'https://mycomap.org/mycomap-bc'},
{project:'Mycoquébec',names:'Roland Labbé',role:'Mycoquébec co-founder teaching mushroom identification',photo:'https://images.squarespace-cdn.com/content/v1/5f943bc43ea3b8421c63158f/327f5909-f4c4-4b3c-8c92-3aad52eb8d06/Joel-Caux-et-Roland-Labbe.png',photoCredit:'Photo: Formations Champignons / Joël Caux',profile:'https://www.mycoquebec.org'},
